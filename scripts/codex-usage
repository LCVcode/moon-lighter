#!/usr/bin/env python3

import json
import subprocess
import sys
import urllib.request
from datetime import datetime

USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"


def get_token():
    result = subprocess.run(
        [
            "pi",
            "auth",
            "print-bearer-token",
            "--provider",
            "openai-codex",
        ],
        capture_output=True,
        text=True,
        check=True,
    )

    token = result.stdout.strip()

    if not token:
        raise RuntimeError("Pi returned an empty bearer token")

    return token


def get_usage(token):
    request = urllib.request.Request(
        USAGE_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            "User-Agent": "pi-usage",
        },
    )

    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def format_reset(timestamp):
    if not timestamp:
        return "unknown"

    return datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d %H:%M")


def print_window(name, window):
    if not window:
        return

    used = float(window.get("used_percent", 0))
    remaining = max(0, min(100, 100 - used))
    reset = format_reset(window.get("reset_at"))

    print(f"{name:8} {remaining:5.1f}% remaining   resets {reset}")


def main():
    try:
        token = get_token()
        usage = get_usage(token)
    except subprocess.CalledProcessError as e:
        print(f"Failed to get Pi credentials: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Failed to retrieve usage: {e}", file=sys.stderr)
        sys.exit(1)

    rate_limit = usage.get("rate_limit", {})

    print(f"OpenAI Codex · {usage.get('plan_type', 'unknown')}")
    print_window("5 hour", rate_limit.get("primary_window"))
    print_window("weekly", rate_limit.get("secondary_window"))


if __name__ == "__main__":
    main()
